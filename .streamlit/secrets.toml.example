# Copia este archivo a .streamlit/secrets.toml para probar en local.
# En Streamlit Community Cloud NO se sube: pega estas líneas en
#   App -> Settings -> Secrets
# Las dos son opcionales y se pueden combinar. Si no pones ninguna, la app sale directo a gutenberg.org.

# URL del Cloudflare Worker de web/proxy/worker.js (el mismo de la versión JS).
# Reenvía solo /ebooks/search.opds/ y /cache/epub/<id>/pg<id>.txt. Si falla, la app prueba gutenberg.org directo.
GUTENBERG_PROXY_URL = "https://huffman-gutenberg.TU-USUARIO.workers.dev"

# Proxy HTTP(S) clásico por el que saldrán las peticiones (opcional).
# GUTENBERG_HTTP_PROXY = "http://usuario:clave@host:puerto"
